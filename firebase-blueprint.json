{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile authenticated via Firebase Auth",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User unique identifier matching auth UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User email address" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "phone": { "type": "string", "description": "Optional phone number" },
        "role": { "type": "string", "description": "Role: client or admin" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Appointment": {
      "title": "Appointment Booking",
      "description": "Tattoo appointment booking request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Appointment document ID" },
        "userId": { "type": "string", "description": "Auth UID of the client who booked" },
        "clientName": { "type": "string", "description": "Full name of client" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "email": { "type": "string", "description": "Contact email" },
        "serviceName": { "type": "string", "description": "Selected tattoo discipline" },
        "artist": { "type": "string", "description": "Selected artist or Any Available" },
        "preferredDate": { "type": "string", "description": "Preferred appointment date" },
        "preferredTime": { "type": "string", "description": "Preferred appointment time" },
        "placement": { "type": "string", "description": "Body placement" },
        "size": { "type": "string", "description": "Approximate dimensions in inches" },
        "isHomeService": { "type": "boolean", "description": "Whether home visit is requested" },
        "notes": { "type": "string", "description": "Client notes and specifications" },
        "status": { "type": "string", "description": "Booking status: pending, confirmed, completed, cancelled" },
        "createdAt": { "type": "string", "description": "ISO timestamp of booking creation" }
      },
      "required": ["id", "userId", "clientName", "phone", "serviceName", "status", "createdAt"]
    },
    "SavedConcept": {
      "title": "Saved Tattoo Concept",
      "description": "Tattoo design concept generated by AI or custom planner saved by user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique concept ID" },
        "userId": { "type": "string", "description": "Auth UID of the owner" },
        "title": { "type": "string", "description": "Concept title or brief summary" },
        "conceptText": { "type": "string", "description": "Structured consultation concept text" },
        "style": { "type": "string", "description": "Tattoo style" },
        "placement": { "type": "string", "description": "Anatomical placement" },
        "imageUrl": { "type": "string", "description": "Optional generated stencil or reference preview" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "userId", "title", "conceptText", "createdAt"]
    },
    "Review": {
      "title": "Customer Review",
      "description": "Verified client tattoo review and rating",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Review unique identifier" },
        "userId": { "type": "string", "description": "UID of reviewer if authenticated" },
        "author": { "type": "string", "description": "Client display name" },
        "rating": { "type": "number", "description": "Star rating out of 5" },
        "service": { "type": "string", "description": "Tattoo style received" },
        "review": { "type": "string", "description": "Review comment" },
        "date": { "type": "string", "description": "Date or relative time string" },
        "verified": { "type": "boolean", "description": "Verified client badge" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "author", "rating", "review", "createdAt"]
    },
    "Service": {
      "title": "Tattoo Service",
      "description": "Studio tattoo discipline and offering",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Service slug ID" },
        "title": { "type": "string", "description": "Service name" },
        "subtitle": { "type": "string", "description": "Short descriptive tagline" },
        "description": { "type": "string", "description": "Detailed explanation of discipline" },
        "startingPrice": { "type": "string", "description": "Starting price label" },
        "imageUrl": { "type": "string", "description": "Cover photograph URL" },
        "tags": { "type": "string", "description": "Keywords or category tags" },
        "order": { "type": "number", "description": "Display order index" }
      },
      "required": ["id", "title", "description"]
    },
    "Artist": {
      "title": "Tattoo Artist",
      "description": "Studio resident artist profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Artist slug identifier" },
        "name": { "type": "string", "description": "Artist full name" },
        "role": { "type": "string", "description": "Role: Founder, Senior Resident, etc." },
        "experience": { "type": "string", "description": "Years of experience" },
        "specialties": { "type": "string", "description": "Core specialties" },
        "bio": { "type": "string", "description": "Biography and artistic background" },
        "instagram": { "type": "string", "description": "Instagram handle" },
        "photoUrl": { "type": "string", "description": "Portrait photograph URL" },
        "order": { "type": "number", "description": "Display order" }
      },
      "required": ["id", "name", "role", "specialties"]
    },
    "GalleryItem": {
      "title": "Gallery Portfolio Piece",
      "description": "Tattoo portfolio photo",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Photo unique identifier" },
        "title": { "type": "string", "description": "Piece title or motif description" },
        "style": { "type": "string", "description": "Tattoo style category" },
        "placement": { "type": "string", "description": "Body placement" },
        "imageUrl": { "type": "string", "description": "High resolution image URL" },
        "featured": { "type": "boolean", "description": "Whether featured in hero or 3D view" }
      },
      "required": ["id", "title", "style", "imageUrl"]
    },
    "BlogPost": {
      "title": "Studio Journal Post",
      "description": "Tattoo care guide or artistic journal article",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Article slug identifier" },
        "title": { "type": "string", "description": "Post headline" },
        "slug": { "type": "string", "description": "URL slug" },
        "category": { "type": "string", "description": "Article category" },
        "excerpt": { "type": "string", "description": "Summary blurb" },
        "readTime": { "type": "string", "description": "Estimated read duration" },
        "date": { "type": "string", "description": "Publish date label" },
        "imageUrl": { "type": "string", "description": "Cover image URL" },
        "content": { "type": "string", "description": "Full markdown or text body" }
      },
      "required": ["id", "title", "category", "excerpt", "readTime"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user profile documents readable and writable only by the authenticated owner"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Client booking appointments accessible by the client who created them"
    },
    "/users/{userId}/savedConcepts/{conceptId}": {
      "schema": { "$ref": "#/entities/SavedConcept" },
      "description": "Subcollection of saved tattoo design concepts owned by the user"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer reviews readable by everyone, creatable by authenticated or verified clients"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Studio tattoo services readable publicly by all visitors"
    },
    "/artists/{artistId}": {
      "schema": { "$ref": "#/entities/Artist" },
      "description": "Studio artist profiles readable publicly by all visitors"
    },
    "/gallery/{galleryId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Studio tattoo portfolio items readable publicly by all visitors"
    },
    "/blog/{blogId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Studio journal articles and care guides readable publicly by all visitors"
    }
  }
}
