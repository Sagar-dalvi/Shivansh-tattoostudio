rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254;
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'updatedAt', 'role']);
      allow delete: if false;

      // Subcollection: Saved Concepts
      match /savedConcepts/{conceptId} {
        allow get: if isOwner(userId) && isValidId(conceptId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(conceptId)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 200
                      && request.resource.data.conceptText is string
                      && request.resource.data.conceptText.size() <= 10000;
        allow update: if isOwner(userId)
                      && isValidId(conceptId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'conceptText', 'style', 'placement', 'imageUrl']);
        allow delete: if isOwner(userId) && isValidId(conceptId);
      }
    }

    // --- Appointments Collection ---
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && isValidId(appointmentId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(appointmentId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.clientName is string
                    && request.resource.data.clientName.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.serviceName is string
                    && request.resource.data.serviceName.size() <= 150;
      allow update: if isSignedIn()
                    && isValidId(appointmentId)
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferredDate', 'preferredTime', 'placement', 'size', 'notes', 'status']);
      allow delete: if isSignedIn() && isValidId(appointmentId) && resource.data.userId == request.auth.uid;
    }

    // --- Customer Reviews Collection ---
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create, update: if isValidId(reviewId)
                            && request.resource.data.author is string
                            && request.resource.data.author.size() <= 80
                            && request.resource.data.rating is number
                            && request.resource.data.rating >= 1
                            && request.resource.data.rating <= 5
                            && request.resource.data.review is string
                            && request.resource.data.review.size() <= 1500;
      allow delete: if isSignedIn();
    }

    // --- Public Studio Data Collections (Read by all visitors, writable by admin/seed) ---
    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;
      allow create, update: if isValidId(serviceId);
      allow delete: if isSignedIn();
    }

    match /artists/{artistId} {
      allow get: if isValidId(artistId);
      allow list: if true;
      allow create, update: if isValidId(artistId);
      allow delete: if isSignedIn();
    }

    match /gallery/{galleryId} {
      allow get: if isValidId(galleryId);
      allow list: if true;
      allow create, update: if isValidId(galleryId);
      allow delete: if isSignedIn();
    }

    match /blog/{blogId} {
      allow get: if isValidId(blogId);
      allow list: if true;
      allow create, update: if isValidId(blogId);
      allow delete: if isSignedIn();
    }
  }
}
